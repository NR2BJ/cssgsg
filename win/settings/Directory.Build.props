<Project>
  <!-- 빌드 결과는 저장소 밖으로(build/는 .gitignore에 있다). NuGet 복원보다 먼저 정해야 해서 여기 둔다. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\build\settings\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\build\settings\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
