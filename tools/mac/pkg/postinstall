#!/bin/bash
# cssgsg pkg postinstall (root로 돈다). NRIME처럼 최소로 한다.
# - 여기서 swift나 codesign을 부르지 않는다(알림·권한 창이 뜬다). 서명은 빌드 때 끝낸다.
# - 입력 소스 등록과 켜기는 앱이 처음 뜰 때 스스로 한다(InputSourceSetup). 그래서 여기서는 앱을 한 번 띄운다.
APP="/Library/Input Methods/cssgsg.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Versions/Current/Frameworks/LaunchServices.framework/Versions/Current/Support/lsregister"

# 옛 버전을 끝낸다. 입력 소스로 쓰던 중이면 아래에서 새 버전이 바로 뜬다.
killall cssgsg 2>/dev/null || true
sleep 1

xattr -cr "$APP" 2>/dev/null || true

CONSOLE_USER="$(stat -f "%Su" /dev/console 2>/dev/null || true)"
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null || true)"
    if [ -n "$CONSOLE_UID" ]; then
        # LaunchServices 등록과 실행은 사용자 세션에서 한다(root로 하면 root의 목록에 들어간다).
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" "$LSREGISTER" -f "$APP" 2>/dev/null || true
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" /usr/bin/open -g "$APP" 2>/dev/null || true
    fi
fi

exit 0
