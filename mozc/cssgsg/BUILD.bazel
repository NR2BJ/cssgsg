# cssgsg용 Mozc C API. tools/mozc/build.sh가 이 폴더를 Mozc 소스 트리의 src/cssgsg로 복사해서 빌드한다.
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("//:build_defs.bzl", "mozc_cc_binary", "mozc_cc_library")

mozc_cc_library(
    name = "cssgsg_mozc",
    srcs = ["cssgsg_mozc.cc"],
    hdrs = ["cssgsg_mozc.h"],
    deps = [
        "//base:system_util",
        "//base/strings:unicode",
        "//config:config_handler",
        "//data_manager",
        "//engine",
        "//engine:engine_interface",
        "//protocol:candidate_window_cc_proto",
        "//protocol:commands_cc_proto",
        "//protocol:config_cc_proto",
        "//session:session_handler",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/strings:str_format",
        "@com_google_absl//absl/synchronization",
    ],
)

# 입력기에 링크할 정적 라이브러리 하나(Mozc와 의존성 전부).
cc_static_library(
    name = "cssgsg_mozc_static",
    deps = [":cssgsg_mozc"],
)

mozc_cc_binary(
    name = "cssgsg_mozc_main",
    srcs = ["cssgsg_mozc_main.cc"],
    deps = [":cssgsg_mozc"],
)
